# Đổi PORT nếu nhà cung cấp hosting yêu cầu (Render/Railway tự set PORT)
PORT=3000

# Chuỗi bí mật để ký JWT - PHẢI đổi thành chuỗi ngẫu nhiên dài khi deploy thật
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-rat-dai-va-kho-doan

# Connection string lấy từ MongoDB Atlas (xem README.md để biết cách lấy)
MONGODB_URI=mongodb+srv://tenuser:matkhau@cluster0.xxxxx.mongodb.net/webshop?retryWrites=true&w=majority

# Tài khoản admin mặc định được tạo tự động khi server khởi động lần đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
